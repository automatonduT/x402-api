{
 "openapi": "3.0.3",
 "info": {
  "title": "micro-tools by automaton-alpha",
  "version": "1.4.0",
  "description": "Free + x402-paid micro-tools. Paid calls return HTTP 402 with accepts {scheme:exact,network:base}; pay USDC on Base, retry with X-PAYMENT header."
 },
 "servers": [
  {
   "url": "https://skintight-snowcap-underarm.ngrok-free.dev"
  }
 ],
 "paths": {
  "/tools/x402/inspect": {
   "get": {
    "summary": "Inspect any URL x402-readiness (free)",
    "parameters": [
     {
      "name": "url",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "verdict PAYABLE/402_SANS_ACCEPTS/FREE_OR_OPEN"
     }
    }
   }
  },
  "/tools/x402/validate-pricing": {
   "post": {
    "summary": "Validate pricing params (free)",
    "responses": {
     "200": {
      "description": "validation report"
     }
    }
   }
  },
  "/tools/batch": {
   "post": {
    "summary": "Batch inspect (paid x402 0.01 USDC)",
    "responses": {
     "402": {
      "description": "payment required"
     }
    }
   }
  },
  "/tools/market/premium/scan": {
   "get": {
    "summary": "Premium carry scan (paid x402 0.03 USDC)",
    "responses": {
     "402": {
      "description": "payment required"
     }
    }
   }
  },
  "/tools/market/premium/deep-backtest": {
   "get": {
    "summary": "Deep backtest (paid x402 0.05 USDC)",
    "responses": {
     "402": {
      "description": "payment required"
     }
    }
   }
  },
  "/tools/strategy-check": {
   "post": {
    "summary": "CSV OHLC -> DEPLOY/REFUSE verdict (paid x402 0.02 USDC)",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "csv"
        ],
        "properties": {
         "csv": {
          "type": "string",
          "description": "OHLC rows >=20 bars"
         },
         "sl": {
          "type": "number"
         },
         "tp": {
          "type": "number"
         },
         "split": {
          "type": "number"
         },
         "minTrades": {
          "type": "number"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "verdict {decision:DEPLOY|REFUSE,reasons[],best,gap}"
     },
     "400": {
      "description": "invalid csv"
     },
     "402": {
      "description": "x402 payment required",
      "headers": {
       "WWW-Authenticate": {
        "schema": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "/stats": {
   "get": {
    "summary": "Usage counters (free)",
    "responses": {
     "200": {
      "description": "{ok,free,paid,total,uptimeS}"
     }
    }
   }
  }
 }
}